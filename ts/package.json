{
  "name": "@jackice/pi-memory-rust",
  "version": "0.1.5",
  "description": "Rust memory extension for Pi: Turso storage + Tantivy FTS + turbovec vectors + local ONNX embedding",
  "author": "jackice",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi",
    "pi-package",
    "memory",
    "rust",
    "turso",
    "vector"
  ],
  "files": [
    "index.ts",
    "src",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "build:binary": "cd .. && cargo build --release && cp target/release/pi-memory-server ts/bin/",
    "build:leaf": "bun scripts/build-leaf.ts",
    "build": "bun run build:binary && bun run build:leaf",
    "pack:verify": "npm pack --dry-run",
    "test": "bun test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@napi-rs/cli": "^3.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@jackice/pi-memory-rust-darwin-arm64": "=0.1.5",
    "@jackice/pi-memory-rust-darwin-x64": "=0.1.5",
    "@jackice/pi-memory-rust-linux-x64": "=0.1.5",
    "@jackice/pi-memory-rust-win32-x64": "=0.1.5"
  },
  "main": "./index.ts"
}
